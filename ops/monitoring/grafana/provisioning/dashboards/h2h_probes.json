{
  "title": "H2H – Probes & Latency",
  "uid": "h2h-probes",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Readiness Probe Success (blackbox)",
