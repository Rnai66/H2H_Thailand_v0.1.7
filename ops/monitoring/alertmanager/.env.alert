# ==== Email (SMTP) – เลือกใช้เมื่ออยากแจ้งทางอีเมล ====
ALERT_EMAIL_TO=YOUR_EMAIL@example.com
ALERT_EMAIL_FROM=ALERT_SENDER@example.com
ALERT_SMTP_HOST=smtp.example.com:587
ALERT_SMTP_USER=SMTP_USER
ALERT_SMTP_PASS=SMTP_PASS
ALERT_EMAIL_TLS=true

# ==== Telegram – เลือกใช้เมื่ออยากแจ้งผ่าน Telegram ====
TELEGRAM_BOT_TOKEN=123456789:TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=123456789

# ==== Routing ====
ALERT_GROUP_WAIT=10s
ALERT_GROUP_INTERVAL=1m
ALERT_REPEAT_INTERVAL=4h
